$TTL 86400
@   IN  SOA haproxy.example.com. admin.example.com. (
    2026110604  ; Serial
    3600        ; Refresh
    1800        ; Retry
    604800      ; Expire
    86400       ; Minimum TTL
)
        IN  NS  haproxy.example.com.

; Machine PTRs
3	IN  PTR neuromancer.example.com.
10      IN  PTR bootstrap.okd.example.com.
11      IN  PTR ctl1.okd.example.com.
12      IN  PTR ctl2.okd.example.com.
13      IN  PTR ctl3.okd.example.com.
14      IN  PTR wk1.okd.example.com.
15      IN  PTR wk2.okd.example.com.
16	IN  PTR armitage.example.com.
17      IN  PTR wk3.okd.example.com.

; HAProxy & OKD API routing targets
46      IN  PTR haproxy.example.com.
46      IN  PTR api.okd.example.com.
46      IN  PTR api-int.okd.example.com.

